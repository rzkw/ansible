[DEFAULT]
bantime = 3600
findtime = 600
maxretry = 5
backend = systemd
ignoreip = 127.0.0.1/8 192.168.55.104 100.92.145.128 100.64.0.0/10

[sshd]
enabled = true
port = ssh
filter = sshd
logpath = %(sshd_log)s
maxretry = 4
bantime = 7200

[ufw]
enabled = true
filter = ufw
logpath = /var/log/ufw.log
maxretry = 10
bantime = 3600
